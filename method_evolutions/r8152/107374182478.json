{"mid": "107374182478", "sa": {"id": "107374182478", "name": "set_ethernet_addr", "file_path": "r8152.c", "features": {"loc": 17, "cyclomatic_complexity": 4, "fan_in": 2, "fan_out": 13, "code": "static int set_ethernet_addr(struct r8152 *tp, bool in_resume)\n{\n\tstruct net_device *dev = tp->netdev;\n\tstruct sockaddr_storage ss;\n\tint ret;\n\n\tret = determine_ethernet_addr(tp, &ss);\n\tif (ret < 0)\n\t\treturn ret;\n\n\tif (tp->version == RTL_VER_01)\n\t\teth_hw_addr_set(dev, ss.__data);\n\telse\n\t\tret = __rtl8152_set_mac_address(dev, &ss, in_resume);\n\n\treturn ret;\n}"}}, "ev": [{"h": "21cff123", "d": "2019-08-31 15:46:25+09:00", "msg": "Added r8152.53.56-2.12.0.tar.", "nd": 0, "ni": 13635, "cxc": 5}, {"h": "eef1e4e4", "d": "2020-06-20 17:30:11+09:00", "msg": "Added r8152.53.56-2.13.0.tar.bz2", "nd": 1422, "ni": 7209, "cxc": 3}, {"h": "a90e4e08", "d": "2022-08-11 21:36:43+09:00", "msg": "Added r8152-2.16.3.tar.bz2.", "nd": 423, "ni": 1139, "cxc": 3}, {"h": "a90e4e08", "d": "2022-08-11 21:36:43+09:00", "msg": "Added r8152-2.16.3.tar.bz2.", "nd": 423, "ni": 1139, "cxc": 3}, {"h": "ec663db7", "d": "2024-06-11 23:29:56+09:00", "msg": "Added r8152-2.18.1.tar.bz2.", "nd": 4952, "ni": 9402, "cxc": 3}, {"h": "ba75ce32", "d": "2026-02-05 00:34:03+09:00", "msg": "Added r8152-2.21.4.tar.bz2.", "nd": 615, "ni": 3557, "cxc": 3}]}